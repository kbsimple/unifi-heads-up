# UniFi Console — LAN direct access
# Set UNIFI_HOST to the console's LAN IP or hostname.
# Include :port if the console is not on port 443 (e.g., 192.168.1.1:8443 for older controllers).
UNIFI_HOST="192.168.1.1"

# API key from: UniFi OS > Settings > API > Create API Key
UNIFI_API_KEY="your-api-key-here"

# Clients API path version: "v2" (default) for newer firmware, "v1" for older firmware.
# Set to "v1" if devices show empty. Test with:
#   wget --no-check-certificate https://<host>/proxy/network/api/s/default/stat/sta
# UNIFI_API_VERSION=v1

# App authentication (bcrypt hashes — generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))")
ADMIN_USER="admin"
ADMIN_PASSWORD="bcrypt-hash-here"
FAMILY_USER="family"
FAMILY_PASSWORD="bcrypt-hash-here"

# Session signing key — minimum 32 characters, random
# Generate with: openssl rand -hex 32
SESSION_SECRET="minimum-32-character-random-string-here"

# Port (default: 3000)
PORT=3000

# Set to true only if serving over HTTPS. Leave unset or false for plain HTTP (LAN deployments).
SECURE_COOKIES=false
